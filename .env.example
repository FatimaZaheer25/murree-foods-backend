# Copy to .env and fill in. Never commit .env.

MONGODB_URI=
PORT=5000

# Allowed frontend origins (website, admin panel, rider panel), comma separated, no trailing slash
CLIENT_URL=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Gmail address and a Gmail App Password (not the normal password)
EMAIL_USER=
EMAIL_PASS=
# Optional: where Help & Contact messages are emailed. Empty = EMAIL_USER.
# Messages are always saved in Admin -> Messages, even if the email fails.
CONTACT_INBOX=

# Long random string
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Backend host only (leave unset locally) ---
# Makes the login cookie Secure and SameSite=None
# NODE_ENV=production
# Number of proxies in front of the backend, so rate limits see the real user IP.
# Example: Vercel rewrite + one load balancer on the host = 2
# TRUST_PROXY=2
